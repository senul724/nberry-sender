# Base URL of the nBerry API. Leave empty for same-origin (dev proxy or prod routing of /v1/*).
VITE_API_BASE_URL=
# Base of the links/QR codes shown to users. Trailing slash is stripped.
VITE_LINK_BASE_URL=https://nberry.app
# Google OAuth client id. When unset, the Google sign-in button is hidden.
VITE_GOOGLE_CLIENT_ID=
